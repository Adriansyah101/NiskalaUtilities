#include <winres.h>

#define NISKALA_TEXT(value) NISKALA_TEXT_(value)
#define NISKALA_TEXT_(value) #value

1 ICON "niskala.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Launcher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NISKALA_VERSION_NUMBERS
 PRODUCTVERSION NISKALA_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Niskala Project"
            VALUE "FileDescription", "Niskala Utilities"
            VALUE "FileVersion", NISKALA_TEXT(NISKALA_VERSION)
            VALUE "InternalName", "Niskala.Launcher"
            VALUE "LegalCopyright", "Copyright (c) 2026 Niskala Project"
            VALUE "OriginalFilename", "Niskala.exe"
            VALUE "ProductName", "Niskala Utilities"
            VALUE "ProductVersion", NISKALA_TEXT(NISKALA_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
