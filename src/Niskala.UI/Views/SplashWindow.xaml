<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Niskala.UI.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Niskala.UI.Views"
    Title="Niskala Utilities">
  <Grid x:Name="Root">
    <Grid.Resources>
      <Storyboard x:Name="Intro">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Brand" Storyboard.TargetProperty="Opacity">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
          <LinearDoubleKeyFrame KeyTime="0:0:1" Value="1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BrandShift" Storyboard.TargetProperty="Y">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="8" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="8" />
          <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0">
            <EasingDoubleKeyFrame.EasingFunction>
              <CubicEase EasingMode="EaseOut" />
            </EasingDoubleKeyFrame.EasingFunction>
          </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <Storyboard x:Name="Outro">
        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
      </Storyboard>
    </Grid.Resources>

    <Border CornerRadius="12" Background="{StaticResource NiskalaBrandBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:NiskalaMark x:Name="Mark" Width="110" Height="100" Margin="16,0,0,0" HorizontalAlignment="Center" />
        <StackPanel x:Name="Brand" Margin="0,26,0,0" Spacing="8">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="BrandShift" />
          </StackPanel.RenderTransform>
          <TextBlock Text="NISKALA" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="30" FontWeight="SemiLight"
                     CharacterSpacing="320" Margin="10,0,0,0" Foreground="#FFFFFF" HorizontalAlignment="Center" />
          <TextBlock Text="UTILITIES" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold"
                     CharacterSpacing="420" Margin="5,0,0,0" Foreground="#C4D6E8" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
