<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.StorageMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{x:Bind ViewModel.S.NavStorage}" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{x:Bind ViewModel.S.StorageSubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Informational" IsClosable="True" Message="{x:Bind ViewModel.Info, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Info), Mode=OneWay}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Text="{x:Bind ViewModel.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="C:\" />
      <Button Grid.Column="1" Content="{x:Bind ViewModel.S.Browse}" Command="{x:Bind ViewModel.BrowseCommand}" />
      <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.S.MapAction}" Command="{x:Bind ViewModel.MapCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
      <Button Grid.Column="3" Content="{x:Bind ViewModel.S.Cancel}" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      <Button Grid.Column="4" Command="{x:Bind ViewModel.UpCommand}" IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.S.Up}">
        <FontIcon Glyph="&#xE74A;" FontSize="14" />
      </Button>
    </Grid>

    <Grid Grid.Row="3" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Padding="4">
        <Grid RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,8,12,0">
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Children}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOpen">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:StorageRow">
                <Grid ColumnSpacing="12" Padding="4,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Node.Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Maximum="100" Value="{x:Bind Percent}" />
                    <TextBlock Text="{x:Bind Counts}" Style="{StaticResource CaptionMutedStyle}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{x:Bind Size}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="OnReveal" Tag="{x:Bind}"
                          ToolTipService.ToolTip="{x:Bind services:Strings.Current.ShowInExplorer}">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.S.StorageIdle}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{x:Bind services:Format.Empty(ViewModel.Children.Count), Mode=OneWay}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="4">
        <Grid RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{x:Bind ViewModel.S.Extensions}" Style="{StaticResource SectionLabelStyle}" Margin="12,8,12,0" />
          <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Extensions}" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:ExtensionRow">
                <Grid ColumnSpacing="10" Padding="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="3">
                    <TextBlock Text="{x:Bind Extension}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar Maximum="100" Value="{x:Bind Percent}" />
                    <TextBlock Text="{x:Bind Files}" Style="{StaticResource CaptionMutedStyle}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{x:Bind Size}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
