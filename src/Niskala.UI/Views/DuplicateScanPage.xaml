<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.DuplicateScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.S.NavDuplicates}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Bind ViewModel.S.DuplicatesSubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="{x:Bind ViewModel.S.Scan}" Command="{x:Bind ViewModel.ScanCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        <Button x:Name="RemoveButton" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.S.RemoveCopies}" Click="OnRemove"
                IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}" />
        <Button Content="{x:Bind ViewModel.S.Cancel}" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Info, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Info), Mode=OneWay}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ItemsView ItemsSource="{x:Bind ViewModel.Folders}" SelectionMode="None">
        <ItemsView.Layout>
          <LinedFlowLayout LineSpacing="6" MinItemSpacing="6" />
        </ItemsView.Layout>
        <ItemsView.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <ItemContainer>
              <Border Style="{StaticResource PillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                  <Button Padding="2" Background="Transparent" BorderThickness="0" Click="OnRemoveFolder" Tag="{x:Bind}">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                  </Button>
                </StackPanel>
              </Border>
            </ItemContainer>
          </DataTemplate>
        </ItemsView.ItemTemplate>
      </ItemsView>
      <Button Grid.Column="1" Content="{x:Bind ViewModel.S.AddFolder}" Command="{x:Bind ViewModel.AddFolderCommand}" VerticalAlignment="Top" />
      <ComboBox Grid.Column="2" SelectedIndex="{x:Bind ViewModel.KeepIndex, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="220">
        <ComboBoxItem Content="{x:Bind ViewModel.S.KeepOldest}" />
        <ComboBoxItem Content="{x:Bind ViewModel.S.KeepNewest}" />
      </ComboBox>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
      <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
      <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" />
      <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" />
    </StackPanel>

    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="4">
      <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:DuplicateRow">
              <Grid ColumnSpacing="12" Padding="4,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Mark}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind services:Format.Visible(IsHeader)}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource MonoTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind Title}" Visibility="{x:Bind services:Format.Collapsed(IsHeader)}" />
                <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="{x:Bind ViewModel.S.DuplicatesIdle}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind services:Format.Empty(ViewModel.Rows.Count), Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
