<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.RepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:views="using:Niskala.UI.Views"
    xmlns:services="using:Niskala.UI.Services">
  <UserControl.Resources>
    <views:LogLineTemplates x:Key="LogTemplates">
      <views:LogLineTemplates.Command>
        <DataTemplate x:DataType="vm:LogLine">
          <TextBlock Text="{x:Bind Text}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource NiskalaAccentBrush}" />
        </DataTemplate>
      </views:LogLineTemplates.Command>
      <views:LogLineTemplates.Output>
        <DataTemplate x:DataType="vm:LogLine">
          <TextBlock Text="{x:Bind Text}" Style="{StaticResource MonoTextStyle}" />
        </DataTemplate>
      </views:LogLineTemplates.Output>
      <views:LogLineTemplates.Error>
        <DataTemplate x:DataType="vm:LogLine">
          <TextBlock Text="{x:Bind Text}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource NiskalaDangerBrush}" />
        </DataTemplate>
      </views:LogLineTemplates.Error>
    </views:LogLineTemplates>
  </UserControl.Resources>

  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{x:Bind ViewModel.S.RepairTitle}" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{x:Bind ViewModel.S.RepairSubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Warning" IsClosable="True" Message="{x:Bind ViewModel.Warning, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Warning), Mode=OneWay}" />
      <InfoBar Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Result, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Result), Mode=OneWay}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Padding="4">
        <ListView ItemsSource="{x:Bind ViewModel.Commands}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single"
                  IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:RepairRow">
              <Grid ColumnSpacing="12" Padding="4,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource NiskalaPlateBrush}" VerticalAlignment="Top">
                  <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource NiskalaMutedBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Traits}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
              <TextBlock Text="{x:Bind ViewModel.SelectedName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" />
              <TextBlock Text="{x:Bind ViewModel.SelectedSummary, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
              <TextBlock Text="{x:Bind ViewModel.SelectedCommandLine, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource NiskalaAccentBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" Click="OnRun" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE768;" FontSize="13" />
                  <TextBlock Text="{x:Bind ViewModel.S.RepairRun}" />
                </StackPanel>
              </Button>
              <Button Content="{x:Bind ViewModel.S.Cancel}" Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar IsIndeterminate="False" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Percent, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PercentText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontFamily="{StaticResource NiskalaMonoFont}"
                       MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Elapsed, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" FontFamily="{StaticResource NiskalaMonoFont}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind ViewModel.LiveLine, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Grid>

          <Border Grid.Row="2" CornerRadius="8" Background="{ThemeResource NiskalaBackgroundBrush}" BorderBrush="{ThemeResource NiskalaStrokeBrush}" BorderThickness="1" Padding="10,6">
            <Grid>
              <ListView x:Name="Log" ItemsSource="{x:Bind ViewModel.Lines}" ItemTemplateSelector="{StaticResource LogTemplates}" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="2,0" />
                  </Style>
                </ListView.ItemContainerStyle>
              </ListView>
              <TextBlock Text="{x:Bind ViewModel.S.RepairIdle}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{x:Bind services:Format.Empty(ViewModel.Lines.Count), Mode=OneWay}" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
