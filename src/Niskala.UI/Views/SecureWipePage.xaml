<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.SecureWipePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{x:Bind ViewModel.S.NavWipe}" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{x:Bind ViewModel.S.WipeSubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Warning" IsClosable="False" IsOpen="True" Message="{x:Bind ViewModel.S.SsdNote}" />
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Info, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Info), Mode=OneWay}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox SelectedIndex="{x:Bind ViewModel.MethodIndex, Mode=TwoWay}" MinWidth="240" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
        <ComboBoxItem Content="{x:Bind ViewModel.S.MethodZero}" />
        <ComboBoxItem Content="{x:Bind ViewModel.S.MethodDod}" />
        <ComboBoxItem Content="{x:Bind ViewModel.S.MethodGutmann}" />
      </ComboBox>
      <ProgressBar Grid.Column="1" Maximum="100" Value="{x:Bind ViewModel.Percent, Mode=OneWay}" VerticalAlignment="Center" Margin="8,0" />
      <Button Grid.Column="2" Content="{x:Bind ViewModel.S.Cancel}" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>

    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />

    <Grid Grid.Row="4" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Padding="4">
        <Grid RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,8,8,0">
            <Button Content="{x:Bind ViewModel.S.AddFile}" Command="{x:Bind ViewModel.AddFileCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            <Button x:Name="WipeFilesButton" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.S.WipeFiles}" Click="OnWipeFiles"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
          </StackPanel>
          <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Grid ColumnSpacing="8" Padding="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind}" Style="{StaticResource MonoTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Click="OnRemoveFile" Tag="{x:Bind}">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Bind ViewModel.S.FreeSpaceTitle}" Style="{StaticResource SectionLabelStyle}" />
          <ComboBox ItemsSource="{x:Bind ViewModel.Drives}" SelectedIndex="{x:Bind ViewModel.DriveIndex, Mode=TwoWay}" MinWidth="160" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
          <Button x:Name="WipeFreeButton" Content="{x:Bind ViewModel.S.WipeFreeSpace}" Click="OnWipeFree" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
