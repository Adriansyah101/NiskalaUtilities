<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.UpdateOfferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Niskala.UI.Services">
  <StackPanel Width="440" Spacing="14">
    <TextBlock Text="{x:Bind S.UpdatePromptIntro}" Style="{StaticResource MutedTextStyle}" />

    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}" Padding="14,10">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind S.UpdateThisCopy}" Style="{StaticResource CaptionMutedStyle}" />
          <TextBlock Text="{x:Bind Offer.Current}" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
      </Border>
      <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource NiskalaFaintBrush}" />
      <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,10" Background="{ThemeResource NiskalaAccentSoftBrush}">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind S.UpdateLatestLabel}" Style="{StaticResource CaptionMutedStyle}" />
          <TextBlock Text="{x:Bind Offer.Latest}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource NiskalaAccentBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Spacing="8">
      <TextBlock Text="{x:Bind S.UpdatePromptWhatsNew(Offer.Latest)}" Style="{StaticResource SectionLabelStyle}" />
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind services:Format.Visible(Offer.HasHighlights)}">
        <ItemsControl ItemsSource="{x:Bind Offer.Highlights}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" Foreground="{ThemeResource NiskalaAccentBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Text="{x:Bind S.UpdatePromptNoNotes}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind services:Format.Collapsed(Offer.HasHighlights)}" />
      <TextBlock Text="{x:Bind S.UpdatePromptMore(Offer.More)}" Style="{StaticResource CaptionMutedStyle}" Visibility="{x:Bind services:Format.Visible(Offer.HasMore)}" />
    </StackPanel>
  </StackPanel>
</UserControl>
