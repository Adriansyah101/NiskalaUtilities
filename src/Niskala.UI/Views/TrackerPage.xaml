<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.TrackerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:views="using:Niskala.UI.Views"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{x:Bind ViewModel.S.TrackerTitle}" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="{x:Bind ViewModel.S.TrackerSubtitle}" Style="{StaticResource CaptionMutedStyle}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Result, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Result), Mode=OneWay}" />
    </StackPanel>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
      <Grid ColumnSpacing="12" RowSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Header="{x:Bind ViewModel.S.LabelInstaller}" Text="{x:Bind ViewModel.InstallerPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
          <Button Grid.Column="1" VerticalAlignment="Bottom" Content="{x:Bind ViewModel.S.Browse}" Command="{x:Bind ViewModel.BrowseCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        </Grid>
        <TextBox Grid.Column="1" Header="{x:Bind ViewModel.S.LabelArguments}" Text="{x:Bind ViewModel.Arguments, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        <TextBox Grid.Column="2" Header="{x:Bind ViewModel.S.LabelName}" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        <Button Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RecordCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE7C8;" FontSize="13" />
            <TextBlock Text="{x:Bind ViewModel.S.Record}" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{x:Bind ViewModel.S.RecordHint}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource CardStyle}" BorderBrush="{ThemeResource NiskalaAccentBrush}" Visibility="{x:Bind services:Format.Visible(ViewModel.IsRecording), Mode=OneWay}">
      <Grid ColumnSpacing="16" RowSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
          <TextBlock Text="{x:Bind ViewModel.Stage, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <ProgressBar IsIndeterminate="True" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="{x:Bind ViewModel.S.FinishNow}" Command="{x:Bind ViewModel.FinishNowCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.S.FinishNowHint}" />
          <Button Content="{x:Bind ViewModel.S.Abandon}" Command="{x:Bind ViewModel.AbandonCommand}" />
        </StackPanel>
        <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{x:Bind ViewModel.Processes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProcessRow">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="8" Height="8" VerticalAlignment="Center">
                  <Ellipse Fill="{ThemeResource NiskalaSuccessBrush}" Visibility="{x:Bind services:Format.Visible(IsRunning), Mode=OneWay}" />
                  <Ellipse Fill="{ThemeResource NiskalaFaintBrush}" Visibility="{x:Bind services:Format.Visible(Exited), Mode=OneWay}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{x:Bind ImagePath}" Style="{StaticResource MonoTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Border Grid.Column="2" Style="{StaticResource PillStyle}" Visibility="{x:Bind services:Format.Visible(Adopted)}">
                  <TextBlock Text="Windows Installer" Style="{StaticResource CaptionMutedStyle}" />
                </Border>
                <TextBlock Grid.Column="3" Text="{x:Bind IdText}" Style="{StaticResource CaptionMutedStyle}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Padding="4">
        <Grid RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{x:Bind ViewModel.S.LogsTitle}" Style="{StaticResource SectionLabelStyle}" Margin="12,10,12,4" />
          <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Logs}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:LogItem">
                <StackPanel Padding="0,8" Spacing="1">
                  <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Style="{StaticResource PillStyle}" Visibility="{x:Bind services:Format.Visible(IsRolledBack)}">
                      <TextBlock Text="{x:Bind services:Strings.Current.RolledBack}" Style="{StaticResource CaptionMutedStyle}" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{x:Bind When}" Style="{StaticResource CaptionMutedStyle}" />
                  <TextBlock Text="{x:Bind Counts}" Style="{StaticResource CaptionMutedStyle}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.S.NoLogs}" Style="{StaticResource MutedTextStyle}" Margin="12" Visibility="{x:Bind services:Format.Collapsed(ViewModel.HasLogs), Mode=OneWay}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Visibility="{x:Bind services:Format.Visible(ViewModel.HasSelection), Mode=OneWay}">
        <Grid>
          <Grid RowSpacing="12" Visibility="{x:Bind services:Format.Collapsed(ViewModel.ShowReview), Mode=OneWay}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.S.Rollback}" Command="{x:Bind ViewModel.PlanRollbackCommand}" />
              <Button Grid.Column="2" VerticalAlignment="Top" Content="{x:Bind ViewModel.S.DeleteLog}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Width="280" Spacing="10">
                      <TextBlock Text="{x:Bind ViewModel.S.DeleteLogConfirm}" TextWrapping="Wrap" />
                      <Button Content="{x:Bind ViewModel.S.Delete}" Command="{x:Bind ViewModel.DeleteLogCommand}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.S.Changes}" Style="{StaticResource SectionLabelStyle}" />
            <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Changes, Mode=OneWay}" SelectionMode="None">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeRow">
                  <Grid ColumnSpacing="10" Padding="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource NiskalaMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Path}" Style="{StaticResource MonoTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Change}" Style="{StaticResource CaptionMutedStyle}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>

          <Grid RowSpacing="10" Visibility="{x:Bind services:Format.Visible(ViewModel.ShowReview), Mode=OneWay}">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <views:LeftoverReviewView ViewModel="{x:Bind ViewModel.Review}" />
            <Expander Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{x:Bind ViewModel.S.KeptTitle}"
                      Visibility="{x:Bind services:Format.VisibleCount(ViewModel.Kept.Count), Mode=OneWay}">
              <ItemsControl ItemsSource="{x:Bind ViewModel.Kept, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
            <Grid Grid.Row="2" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Review.CheckedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <CheckBox Content="{x:Bind ViewModel.S.Permanent}" IsChecked="{x:Bind ViewModel.Review.Permanent, Mode=TwoWay}" />
              </StackPanel>
              <Button Grid.Column="1" Content="{x:Bind ViewModel.S.Cancel}" Command="{x:Bind ViewModel.CancelRollbackCommand}" />
              <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.S.RollbackNow}" Command="{x:Bind ViewModel.RollBackCommand}" />
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
