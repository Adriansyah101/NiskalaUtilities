<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.RegistryIntegrityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.S.NavRegistry}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Bind ViewModel.S.RegistrySubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="{x:Bind ViewModel.S.Scan}" Command="{x:Bind ViewModel.ScanCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        <Button x:Name="FixButton" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.S.RepairSelected}" Click="OnFix"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        <Button Content="{x:Bind ViewModel.S.Cancel}" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Info, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Info), Mode=OneWay}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="{x:Bind ViewModel.S.SelectAll}" Command="{x:Bind ViewModel.SelectAllCommand}" />
        <Button Content="{x:Bind ViewModel.S.SelectNone}" Command="{x:Bind ViewModel.SelectNoneCommand}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,0,0,0">
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
      </StackPanel>
      <CheckBox Grid.Column="2" Content="{x:Bind ViewModel.S.RestorePointOption}" IsChecked="{x:Bind ViewModel.CreateRestorePoint, Mode=TwoWay}" />
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4">
      <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:IssueRow">
              <Grid ColumnSpacing="12" Padding="4,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind Fixable}" MinWidth="0" VerticalAlignment="Center" />
                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource NiskalaMutedBrush}" />
                <StackPanel Grid.Column="2" Spacing="2">
                  <TextBlock Style="{StaticResource CaptionMutedStyle}"><Run Text="{x:Bind Kind}" /></TextBlock>
                  <TextBlock Text="{x:Bind Place}" Style="{StaticResource MonoTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Place}" />
                  <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="{x:Bind ViewModel.S.RegistryIdle}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind services:Format.Empty(ViewModel.Rows.Count), Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
