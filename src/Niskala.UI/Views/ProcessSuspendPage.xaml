<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.ProcessSuspendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.S.NavSuspend}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Bind ViewModel.S.SuspendSubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="{x:Bind ViewModel.S.ResumeAll}" Command="{x:Bind ViewModel.ReleaseAllCommand}" />
        <Button Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.S.Refresh}">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
        </Button>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Informational" IsClosable="True" Message="{x:Bind ViewModel.Info, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Info), Mode=OneWay}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ToggleSwitch Header="{x:Bind ViewModel.S.IdleOnly}" IsOn="{x:Bind ViewModel.IdleOnly, Mode=TwoWay}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom" HorizontalAlignment="Right">
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" />
        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4">
      <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:SuspendRow">
              <Grid ColumnSpacing="12" Padding="4,8" ToolTipService.ToolTip="{x:Bind Refusal}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Refusal}" Style="{StaticResource CaptionMutedStyle}" Foreground="{ThemeResource NiskalaWarningBrush}"
                             Visibility="{x:Bind services:Format.VisibleText(Refusal)}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PillStyle}" Visibility="{x:Bind services:Format.VisibleText(State), Mode=OneWay}">
                  <TextBlock Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Content="{x:Bind services:Strings.Current.SuspendAction}" Command="{x:Bind SuspendCommand}" IsEnabled="{x:Bind IsFree, Mode=OneWay}" />
                  <Button Content="{x:Bind services:Strings.Current.EfficiencyAction}" Command="{x:Bind EfficiencyCommand}" IsEnabled="{x:Bind IsFree, Mode=OneWay}" />
                  <Button Content="{x:Bind services:Strings.Current.CapAction}" Command="{x:Bind CapCommand}" IsEnabled="{x:Bind IsFree, Mode=OneWay}" />
                  <Button Content="{x:Bind services:Strings.Current.ResumeAction}" Command="{x:Bind ReleaseCommand}" IsEnabled="{x:Bind IsHeld, Mode=OneWay}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="{x:Bind ViewModel.S.NothingHere}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind services:Format.Empty(ViewModel.Rows.Count), Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
