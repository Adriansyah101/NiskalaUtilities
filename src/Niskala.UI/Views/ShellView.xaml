<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:views="using:Niskala.UI.Views"
    xmlns:services="using:Niskala.UI.Services">
  <UserControl.Resources>
    <Style x:Key="NavButtonStyle" TargetType="views:NavButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,0,10,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualMargin" Value="-1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="views:NavButton">
            <Grid x:Name="Root" Background="Transparent">
              <Rectangle x:Name="GuideLine" Width="1" Margin="0.5,0,0,0" HorizontalAlignment="Left" Fill="{ThemeResource NiskalaNavGuideBrush}" Visibility="Collapsed" />
              <Rectangle x:Name="Indicator" Width="2" Margin="0,9" HorizontalAlignment="Left" RadiusX="1" RadiusY="1" Fill="{ThemeResource NiskalaAccentBrush}"
                         Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                  <ScaleTransform x:Name="IndicatorScale" ScaleY="0.2" />
                </Rectangle.RenderTransform>
              </Rectangle>
              <Grid x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                <Border x:Name="ActiveFill" Background="{ThemeResource NiskalaAccentSoftBrush}" Opacity="0" />
                <Border x:Name="OpenFill" Background="{ThemeResource NiskalaNavOpenBrush}" Opacity="0" />
                <Border x:Name="HoverFill" Background="{ThemeResource NiskalaNavHoverBrush}" Opacity="0" />
                <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition x:Name="LabelColumn" Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon x:Name="Icon" Glyph="{TemplateBinding Glyph}" FontSize="16" Foreground="{ThemeResource NiskalaMutedBrush}" />
                  <TextBlock x:Name="Text" Grid.Column="1" Text="{TemplateBinding Label}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                             Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <FontIcon x:Name="Trailing" Grid.Column="2" Glyph="{TemplateBinding TrailingGlyph}" FontSize="10" Foreground="{ThemeResource NiskalaFaintBrush}" />
                </Grid>
              </Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.083" />
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter Target="HoverFill.Background" Value="{ThemeResource NiskalaNavPressedBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="EmphasisStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.18">
                      <VisualTransition.GeneratedEasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Plain" />
                  <VisualState x:Name="Open">
                    <VisualState.Setters>
                      <Setter Target="Icon.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="OpenFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Active">
                    <VisualState.Setters>
                      <Setter Target="Icon.Foreground" Value="{ThemeResource NiskalaAccentBrush}" />
                      <Setter Target="Text.Foreground" Value="{ThemeResource NiskalaAccentBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ActiveFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="IndicatorScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="WidthStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition From="Compact" To="Full">
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Text" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" />
                        <DoubleAnimation Storyboard.TargetName="Trailing" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" />
                      </Storyboard>
                    </VisualTransition>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Full" />
                  <VisualState x:Name="Compact">
                    <VisualState.Setters>
                      <Setter Target="Text.Visibility" Value="Collapsed" />
                      <Setter Target="Trailing.Visibility" Value="Collapsed" />
                      <Setter Target="LabelColumn.Width" Value="0" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="GuideStates">
                  <VisualState x:Name="NoGuide" />
                  <VisualState x:Name="Guide">
                    <VisualState.Setters>
                      <Setter Target="GuideLine.Visibility" Value="Visible" />
                      <Setter Target="Indicator.Visibility" Value="Visible" />
                      <Setter Target="Pill.Margin" Value="11,1,0,1" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavPageStyle" TargetType="views:NavButton" BasedOn="{StaticResource NavButtonStyle}">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="10,0,10,0" />
      <Setter Property="HasGuide" Value="True" />
      <Setter Property="FocusVisualMargin" Value="10,0,-1,0" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{ThemeResource NiskalaPaneBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid x:Name="Pane" Padding="8,6,8,8" RowSpacing="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <views:NavButton Style="{StaticResource NavButtonStyle}" Glyph="&#xE700;" HorizontalAlignment="Left" Width="40" Click="OnPaneToggleClick"
                       AutomationProperties.Name="{x:Bind S.NavTogglePane}" ToolTipService.ToolTip="{x:Bind S.NavTogglePane}" IsCompact="True" />

      <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{x:Bind Nav.Categories}" XYFocusKeyboardNavigation="Enabled" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavCategory">
              <StackPanel>
                <views:NavButton Style="{StaticResource NavButtonStyle}" Glyph="{x:Bind Glyph}" Label="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold"
                                 TrailingGlyph="{x:Bind Chevron, Mode=OneWay}" IsActive="{x:Bind IsActive, Mode=OneWay}" IsOpen="{x:Bind IsOpen, Mode=OneWay}"
                                 IsCompact="{x:Bind IsCompact, Mode=OneWay}" Click="OnCategoryClick" />
                <views:Accordion IsExpanded="{x:Bind ShowPages, Mode=OneWay}">
                  <ItemsControl ItemsSource="{x:Bind Pages}" Margin="19,2,0,4" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NavPage">
                        <views:NavButton Style="{StaticResource NavPageStyle}" Glyph="{x:Bind Glyph}" Label="{x:Bind Title, Mode=OneWay}"
                                         IsActive="{x:Bind IsSelected, Mode=OneWay}" Click="OnPageClick" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </views:Accordion>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Spacing="2" BorderBrush="{ThemeResource NiskalaStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0" XYFocusKeyboardNavigation="Enabled">
        <Grid>
          <views:NavButton Style="{StaticResource NavButtonStyle}" Glyph="{x:Bind Nav.Updates.Glyph}" Label="{x:Bind Nav.Updates.Title, Mode=OneWay}"
                           IsActive="{x:Bind Nav.Updates.IsSelected, Mode=OneWay}" IsCompact="{x:Bind Nav.IsCompact, Mode=OneWay}" Click="OnUpdatesClick" />
          <InfoBadge Style="{ThemeResource AttentionDotInfoBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,7,0,0" IsHitTestVisible="False"
                     Visibility="{x:Bind services:Format.Visible(Updates.IsAvailable), Mode=OneWay}" />
        </Grid>
        <views:NavButton x:Name="ThemeButton" Style="{StaticResource NavButtonStyle}" Glyph="&#xE706;" IsCompact="{x:Bind Nav.IsCompact, Mode=OneWay}" Click="OnThemeClick" />
        <views:NavButton Style="{StaticResource NavButtonStyle}" Glyph="&#xE774;" Label="{x:Bind S.SwitchLanguage}" IsCompact="{x:Bind Nav.IsCompact, Mode=OneWay}" Click="OnLanguageClick" />
      </StackPanel>
    </Grid>

    <Border x:Name="PageHost" Grid.Column="1" Background="{ThemeResource NiskalaBackgroundBrush}" CornerRadius="8,0,0,0" />

    <Popup x:Name="PalettePopup" Grid.ColumnSpan="2" IsLightDismissEnabled="True" IsOpen="{x:Bind Palette.IsOpen, Mode=TwoWay}" Opened="OnPaletteOpened">
      <Border x:Name="PaletteCard" Width="600" MaxHeight="460" Background="{ThemeResource NiskalaSurfaceRaisedBrush}" BorderBrush="{ThemeResource NiskalaStrokeBrush}"
              BorderThickness="1" CornerRadius="12" Padding="8">
        <Grid RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBox x:Name="PaletteBox" PlaceholderText="{x:Bind S.PalettePlaceholder}" Text="{x:Bind Palette.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   BorderThickness="0" Background="Transparent" FontSize="15" Padding="10,8" PreviewKeyDown="OnPaletteKeyDown" />
          <ListView Grid.Row="1" ItemsSource="{x:Bind Palette.Results}" SelectedIndex="{x:Bind Palette.SelectedIndex, Mode=TwoWay}" IsItemClickEnabled="True"
                    ItemClick="OnPaletteItemClick" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteEntry">
                <Grid ColumnSpacing="12" Padding="2,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource NiskalaAccentBrush}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>
