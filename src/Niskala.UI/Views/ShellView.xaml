<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels">
  <Grid>
    <NavigationView
        x:Name="Navigation"
        PaneDisplayMode="LeftCompact"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        OpenPaneLength="232"
        SelectionChanged="OnSelectionChanged"
        ItemInvoked="OnItemInvoked">
      <NavigationView.MenuItems>
        <NavigationViewItemHeader Content="{x:Bind S.NavGroupApps}" />
        <NavigationViewItem x:Name="AppsItem" Content="{x:Bind S.NavApps}" Tag="Apps" ToolTipService.ToolTip="{x:Bind S.NavApps}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE71D;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="TrackerItem" Content="{x:Bind S.NavTracker}" Tag="Tracker" ToolTipService.ToolTip="{x:Bind S.NavTracker}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9D9;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="PickerItem" Content="{x:Bind S.NavPicker}" Tag="Picker" ToolTipService.ToolTip="{x:Bind S.NavPicker}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE81D;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemHeader Content="{x:Bind S.NavGroupClean}" />
        <NavigationViewItem x:Name="QuickScanItem" Content="{x:Bind S.NavQuickScan}" Tag="QuickScan" ToolTipService.ToolTip="{x:Bind S.NavQuickScan}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE945;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="SelectiveCleanItem" Content="{x:Bind S.NavSelectiveClean}" Tag="SelectiveClean" ToolTipService.ToolTip="{x:Bind S.NavSelectiveClean}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE74D;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="RegistryItem" Content="{x:Bind S.NavRegistry}" Tag="Registry" ToolTipService.ToolTip="{x:Bind S.NavRegistry}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE9F5;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemHeader Content="{x:Bind S.NavGroupPerformance}" />
        <NavigationViewItem x:Name="ResourcesItem" Content="{x:Bind S.NavResources}" Tag="Resources" ToolTipService.ToolTip="{x:Bind S.NavResources}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xEC4A;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="SuspendItem" Content="{x:Bind S.NavSuspend}" Tag="Suspend" ToolTipService.ToolTip="{x:Bind S.NavSuspend}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE769;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemHeader Content="{x:Bind S.NavGroupTools}" />
        <NavigationViewItem x:Name="StorageItem" Content="{x:Bind S.NavStorage}" Tag="Storage" ToolTipService.ToolTip="{x:Bind S.NavStorage}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xEDA2;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="DuplicatesItem" Content="{x:Bind S.NavDuplicates}" Tag="Duplicates" ToolTipService.ToolTip="{x:Bind S.NavDuplicates}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE8C8;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="WipeItem" Content="{x:Bind S.NavWipe}" Tag="Wipe" ToolTipService.ToolTip="{x:Bind S.NavWipe}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE75C;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="RepairItem" Content="{x:Bind S.NavRepair}" Tag="Repair" ToolTipService.ToolTip="{x:Bind S.NavRepair}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE90F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="HistoryItem" Content="{x:Bind S.NavHistory}" Tag="History" ToolTipService.ToolTip="{x:Bind S.NavHistory}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE81C;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="{x:Bind S.PaletteLauncher}" Tag="Palette" SelectsOnInvoked="False" ToolTipService.ToolTip="Ctrl+K">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE721;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="ThemeItem" Tag="Theme" SelectsOnInvoked="False">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE706;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="{x:Bind S.SwitchLanguage}" Tag="Language" SelectsOnInvoked="False" ToolTipService.ToolTip="{x:Bind S.SwitchLanguage}">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE774;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Border x:Name="PageHost" />
    </NavigationView>

    <Popup x:Name="PalettePopup" IsLightDismissEnabled="True" IsOpen="{x:Bind Palette.IsOpen, Mode=TwoWay}" Opened="OnPaletteOpened">
      <Border x:Name="PaletteCard" Width="600" MaxHeight="460" Background="{ThemeResource NiskalaSurfaceRaisedBrush}" BorderBrush="{ThemeResource NiskalaStrokeBrush}"
              BorderThickness="1" CornerRadius="12" Padding="8">
        <Grid RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBox x:Name="PaletteBox" PlaceholderText="{x:Bind S.PalettePlaceholder}" Text="{x:Bind Palette.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   BorderThickness="0" Background="Transparent" FontSize="15" Padding="10,8" PreviewKeyDown="OnPaletteKeyDown" />
          <ListView Grid.Row="1" ItemsSource="{x:Bind Palette.Results}" SelectedIndex="{x:Bind Palette.SelectedIndex, Mode=TwoWay}" IsItemClickEnabled="True"
                    ItemClick="OnPaletteItemClick" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteEntry">
                <Grid ColumnSpacing="12" Padding="2,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource NiskalaAccentBrush}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>
