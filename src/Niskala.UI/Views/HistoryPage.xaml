<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.S.HistoryTitle}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Bind ViewModel.S.HistorySubtitle}" Style="{StaticResource CaptionMutedStyle}" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.S.Refresh}">
        <FontIcon Glyph="&#xE72C;" FontSize="14" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Success" IsClosable="True" Title="{x:Bind ViewModel.Report, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Report), Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.ReportLines, Mode=OneWay}" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </InfoBar>
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="220" MaxWidth="360" />
        <ColumnDefinition Width="7*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Padding="4">
        <Grid>
          <ListView ItemsSource="{x:Bind ViewModel.Transactions}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:TransactionItem">
                <StackPanel Padding="0,8" Spacing="1">
                  <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Style="{StaticResource PillStyle}" Visibility="{x:Bind services:Format.Visible(IsRestored)}">
                      <TextBlock Text="{x:Bind services:Strings.Current.Restored}" Style="{StaticResource CaptionMutedStyle}" />
                    </Border>
                  </Grid>
                  <TextBlock Style="{StaticResource CaptionMutedStyle}"><Run Text="{x:Bind Kind}" /><Run Text=" · " /><Run Text="{x:Bind When}" /></TextBlock>
                  <TextBlock Text="{x:Bind Counts}" Style="{StaticResource CaptionMutedStyle}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Text="{x:Bind ViewModel.S.NoTransactions}" Style="{StaticResource MutedTextStyle}" Margin="12" Visibility="{x:Bind services:Format.Collapsed(ViewModel.HasTransactions), Mode=OneWay}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Visibility="{x:Bind services:Format.Visible(ViewModel.HasSelection), Mode=OneWay}">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
              <TextBlock Style="{StaticResource CaptionMutedStyle}"><Run Text="{x:Bind ViewModel.Selected.Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.Selected.When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.Selected.Id, Mode=OneWay}" /></TextBlock>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RestoreCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE777;" FontSize="14" />
                <TextBlock Text="{x:Bind ViewModel.S.Restore}" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.S.RestoreHint}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
          <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Bind ViewModel.S.LabelMethod}" Style="{StaticResource SectionLabelStyle}" />
              <TextBlock Text="{x:Bind ViewModel.Method, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{x:Bind ViewModel.S.LabelRestorePoint}" Style="{StaticResource SectionLabelStyle}" />
              <TextBlock Text="{x:Bind ViewModel.RestorePointText, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Records, Mode=OneWay}" SelectionMode="None">
            <ListView.Header>
              <TextBlock Text="{x:Bind ViewModel.S.Items}" Style="{StaticResource SectionLabelStyle}" Margin="12,0,0,6" />
            </ListView.Header>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordRow">
                <Grid ColumnSpacing="10" Padding="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource NiskalaMutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{x:Bind Path}" Style="{StaticResource MonoTextStyle}" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" Visibility="{x:Bind services:Format.VisibleText(Detail)}" />
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource PillStyle}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="7" Height="7" Fill="{ThemeResource NiskalaSuccessBrush}" Visibility="{x:Bind services:Format.Visible(IsGood)}" VerticalAlignment="Center" />
                      <Ellipse Width="7" Height="7" Fill="{ThemeResource NiskalaDangerBrush}" Visibility="{x:Bind services:Format.Visible(IsBad)}" VerticalAlignment="Center" />
                      <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
