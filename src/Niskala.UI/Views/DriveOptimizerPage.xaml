<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.DriveOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:views="using:Niskala.UI.Views"
    xmlns:services="using:Niskala.UI.Services">
  <UserControl.Resources>
    <Style x:Key="LegendSwatchStyle" TargetType="Border">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.S.DrivesTitle}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Bind ViewModel.S.DrivesSubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Top" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.S.Refresh}"
              AutomationProperties.Name="{x:Bind ViewModel.S.Refresh}">
        <FontIcon Glyph="&#xE72C;" FontSize="14" />
      </Button>
    </Grid>

    <InfoBar Grid.Row="1" IsClosable="True" Closed="OnBannerClosed"
             Severity="{x:Bind ViewModel.Banner.Severity, Mode=OneWay}" Message="{x:Bind ViewModel.Banner.Message, Mode=OneWay}"
             IsOpen="{x:Bind ViewModel.Banner.IsOpen, Mode=OneWay}" Visibility="{x:Bind services:Format.VisibleText(ViewModel.Banner.Message), Mode=OneWay}" />

    <Grid Grid.Row="2" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" MinWidth="220" MaxWidth="360" />
        <ColumnDefinition Width="7*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Padding="4">
        <Grid>
          <ListView x:Name="DriveList" ItemsSource="{x:Bind ViewModel.Drives}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.S.DrivesTitle}">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:DriveRow">
                <Grid ColumnSpacing="12" RowSpacing="6" Padding="4,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource NiskalaPlateBrush}" VerticalAlignment="Top">
                    <FontIcon Glyph="&#xEDA2;" FontSize="15" Foreground="{ThemeResource NiskalaMutedBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" Style="{StaticResource PillStyle}" Background="{ThemeResource NiskalaAccentSoftBrush}" BorderThickness="0">
                        <TextBlock Text="{x:Bind Media, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource NiskalaAccentBrush}" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis">
                      <Run Text="{x:Bind FileSystem, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind Capacity, Mode=OneWay}" />
                    </TextBlock>
                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind UsedPercent, Mode=OneWay}" IsIndeterminate="False" />
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Fragmentation, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Action, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource NiskalaAccentBrush}" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Text="{x:Bind ViewModel.S.NoDrives}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{x:Bind services:Format.Empty(ViewModel.Drives.Count), Mode=OneWay}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="96" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="140" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind ViewModel.SelectedFacts, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button Command="{x:Bind ViewModel.AnalyzeCommand}" AutomationProperties.Name="{x:Bind ViewModel.AnalyzeText, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                <TextBlock Text="{x:Bind ViewModel.AnalyzeText, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Modes}" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      MinWidth="140" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.S.DriveModeLabel}"
                      Visibility="{x:Bind services:Format.Visible(ViewModel.ShowModes), Mode=OneWay}" />
            <Button x:Name="PrimaryButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnPrimary" IsEnabled="{x:Bind ViewModel.CanPrimary, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.PrimaryText, Mode=OneWay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE768;" FontSize="13" />
                <TextBlock Text="{x:Bind ViewModel.PrimaryText, Mode=OneWay}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="3" Content="{x:Bind ViewModel.S.Cancel}" Command="{x:Bind ViewModel.CancelCommand}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{x:Bind ViewModel.ModeHint, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind services:Format.Visible(ViewModel.ShowModes), Mode=OneWay}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{x:Bind ViewModel.S.SsdNote}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap"
                       Visibility="{x:Bind services:Format.Visible(ViewModel.ShowSsdNote), Mode=OneWay}" />
          </Grid>

          <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar IsIndeterminate="False" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Percent, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PercentText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" FontFamily="{StaticResource NiskalaMonoFont}"
                       MinWidth="44" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Elapsed, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" FontFamily="{StaticResource NiskalaMonoFont}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind ViewModel.Activity, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind services:Format.VisibleText(ViewModel.Activity), Mode=OneWay}" />
          </Grid>

          <Border Grid.Row="3" CornerRadius="8" Padding="8" Background="{ThemeResource NiskalaBackgroundBrush}" BorderBrush="{ThemeResource NiskalaStrokeBrush}" BorderThickness="1">
            <Grid>
              <views:DriveMapView x:Name="Map" FreeBrush="{ThemeResource NiskalaMapFreeBrush}" UsedBrush="{ThemeResource NiskalaMapUsedBrush}"
                                  FragmentedBrush="{ThemeResource NiskalaMapFragmentedBrush}" ArchiveBrush="{ThemeResource NiskalaMapArchiveBrush}"
                                  SystemBrush="{ThemeResource NiskalaMapSystemBrush}" AutomationProperties.Name="{x:Bind ViewModel.S.LegendUsed}" />
              <TextBlock Text="{x:Bind ViewModel.S.DriveMapEmpty}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                         Visibility="{x:Bind services:Format.Visible(ViewModel.ShowMapEmpty), Mode=OneWay}" />
            </Grid>
          </Border>

          <ItemsControl Grid.Row="4" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="150" ItemHeight="22" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Style="{StaticResource LegendSwatchStyle}" Background="{ThemeResource NiskalaMapFreeBrush}" BorderBrush="{ThemeResource NiskalaStrokeBrush}" BorderThickness="1" />
              <TextBlock Text="{x:Bind ViewModel.S.LegendFree}" Style="{StaticResource CaptionMutedStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Style="{StaticResource LegendSwatchStyle}" Background="{ThemeResource NiskalaMapUsedBrush}" />
              <TextBlock Text="{x:Bind ViewModel.S.LegendUsed}" Style="{StaticResource CaptionMutedStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Style="{StaticResource LegendSwatchStyle}" Background="{ThemeResource NiskalaMapFragmentedBrush}" />
              <TextBlock Text="{x:Bind ViewModel.S.LegendFragmented}" Style="{StaticResource CaptionMutedStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Style="{StaticResource LegendSwatchStyle}" Background="{ThemeResource NiskalaMapArchiveBrush}" />
              <TextBlock Text="{x:Bind ViewModel.S.LegendArchive}" Style="{StaticResource CaptionMutedStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Style="{StaticResource LegendSwatchStyle}" Background="{ThemeResource NiskalaMapSystemBrush}" />
              <TextBlock Text="{x:Bind ViewModel.S.LegendSystem}" Style="{StaticResource CaptionMutedStyle}" />
            </StackPanel>
          </ItemsControl>

          <Grid Grid.Row="5" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
              <SelectorBarItem x:Name="FragmentsTab" Text="{x:Bind ViewModel.S.TabFragmented}" IsEnabled="{x:Bind ViewModel.IsHdd, Mode=OneWay}">
                <SelectorBarItem.Icon>
                  <FontIcon Glyph="&#xE8B7;" />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
              <SelectorBarItem x:Name="SummaryTab" Text="{x:Bind ViewModel.S.TabHealth}">
                <SelectorBarItem.Icon>
                  <FontIcon Glyph="&#xE9D9;" />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
            </SelectorBar>

            <Grid Grid.Row="1" RowSpacing="6" Visibility="{x:Bind services:Format.Visible(ViewModel.ShowFragments), Mode=OneWay}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.FragmentTitle, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{x:Bind ViewModel.S.CheckAll}" Command="{x:Bind ViewModel.CheckAllCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Visibility="{x:Bind services:Format.VisibleCount(ViewModel.Fragments.Count), Mode=OneWay}" />
                <Button Grid.Column="2" Content="{x:Bind ViewModel.S.CheckNone}" Command="{x:Bind ViewModel.CheckNoneCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Visibility="{x:Bind services:Format.VisibleCount(ViewModel.Fragments.Count), Mode=OneWay}" />
                <Button x:Name="CheckedButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.S.DefragChecked}" Click="OnDefragChecked"
                        IsEnabled="{x:Bind ViewModel.CanDefragCheckedNow, Mode=OneWay}" />
              </Grid>
              <Grid Grid.Row="1">
                <ListView ItemsSource="{x:Bind ViewModel.Fragments}" SelectionMode="None" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FragmentRow">
                      <Grid ColumnSpacing="12" Padding="0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox MinWidth="0" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{x:Bind Folder}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind FragmentsText}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                          <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource CaptionMutedStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource PillStyle}" Background="{ThemeResource NiskalaAccentSoftBrush}" BorderThickness="0">
                          <TextBlock Text="{x:Bind ZoneText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource NiskalaAccentBrush}" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Bind ViewModel.FragmentsNote, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Visibility="{x:Bind services:Format.VisibleText(ViewModel.FragmentsNote), Mode=OneWay}" />
              </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1" Visibility="{x:Bind services:Format.Visible(ViewModel.ShowSummary), Mode=OneWay}">
              <Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Summary}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SummaryRow">
                      <Grid ColumnSpacing="14" Padding="2,6" BorderBrush="{ThemeResource NiskalaStrokeBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="2*" MaxWidth="220" />
                          <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind ViewModel.S.DriveSummaryEmpty}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Visibility="{x:Bind services:Format.Empty(ViewModel.Summary.Count), Mode=OneWay}" />
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
