<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.QuickScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.S.NavQuickScan}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Bind ViewModel.S.QuickScanSubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button Content="{x:Bind ViewModel.S.Scan}" Command="{x:Bind ViewModel.ScanCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        <Button x:Name="CleanButton" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind ViewModel.S.CleanNow}" Click="OnClean"
                IsEnabled="{x:Bind ViewModel.CanClean, Mode=OneWay}" />
        <Button Content="{x:Bind ViewModel.S.Cancel}" Command="{x:Bind ViewModel.CancelCommand}" IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.Info, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Info), Mode=OneWay}" />
      <InfoBar Severity="Informational" IsClosable="False" Message="{x:Bind ViewModel.Locked, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Locked), Mode=OneWay}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind ViewModel.S.SystemJunk}" Style="{StaticResource SectionLabelStyle}" />
          <TextBlock Text="{x:Bind ViewModel.SystemTotal, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind ViewModel.S.BrowserCaches}" Style="{StaticResource SectionLabelStyle}" />
          <TextBlock Text="{x:Bind ViewModel.BrowserTotal, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind ViewModel.S.HeavyStartup}" Style="{StaticResource SectionLabelStyle}" />
          <TextBlock Text="{x:Bind ViewModel.StartupTotal, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16" />
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
      </StackPanel>
      <CheckBox Grid.Column="1" Content="{x:Bind ViewModel.S.RestorePointOption}" IsChecked="{x:Bind ViewModel.CreateRestorePoint, Mode=TwoWay}" />
    </Grid>

    <Grid Grid.Row="4" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource CardStyle}" Padding="4">
        <Grid>
          <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:CleanRuleRow">
                <Grid ColumnSpacing="12" Padding="4,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind IsReady, Mode=OneWay}" MinWidth="0" VerticalAlignment="Center" />
                  <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource NiskalaMutedBrush}" />
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Traits}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Text="{x:Bind ViewModel.S.QuickScanIdle}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{x:Bind services:Format.Empty(ViewModel.Rows.Count), Mode=OneWay}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="4">
        <Grid RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{x:Bind ViewModel.S.HeavyStartup}" Style="{StaticResource SectionLabelStyle}" Margin="12,8,12,0" />
          <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Startup}" SelectionMode="None">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:HindranceRow">
                <Grid ColumnSpacing="10" Padding="4,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{x:Bind services:Strings.Current.SwitchOff}" Command="{x:Bind SwitchOffCommand}"
                          IsEnabled="{x:Bind CanSwitchOff, Mode=OneWay}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
