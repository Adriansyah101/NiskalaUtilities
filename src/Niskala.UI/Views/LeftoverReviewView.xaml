<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.LeftoverReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:services="using:Niskala.UI.Services">
  <Grid RowSpacing="8" ColumnSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="320" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="2" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged" Visibility="{x:Bind services:Format.Visible(ViewModel.ShowTabs), Mode=OneWay}">
        <SelectorBarItem x:Name="FilesTab" Text="{x:Bind ViewModel.FilesTabText, Mode=OneWay}">
          <SelectorBarItem.Icon>
            <FontIcon Glyph="&#xE8B7;" />
          </SelectorBarItem.Icon>
        </SelectorBarItem>
        <SelectorBarItem x:Name="RegistryTab" Text="{x:Bind ViewModel.RegistryTabText, Mode=OneWay}">
          <SelectorBarItem.Icon>
            <FontIcon Glyph="&#xE74C;" />
          </SelectorBarItem.Icon>
        </SelectorBarItem>
      </SelectorBar>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Padding="4,0,6,0" Visibility="{x:Bind services:Format.Collapsed(ViewModel.ShowTabs), Mode=OneWay}">
        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{ThemeResource NiskalaAccentBrush}" Visibility="{x:Bind services:Format.Visible(ViewModel.ShowPermanent), Mode=OneWay}" />
        <FontIcon Glyph="&#xE74C;" FontSize="15" Foreground="{ThemeResource NiskalaAccentBrush}" Visibility="{x:Bind services:Format.Collapsed(ViewModel.ShowPermanent), Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.ScopeTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <ToggleButton Style="{StaticResource ChipStyle}" IsChecked="{x:Bind ViewModel.ShowSafe, Mode=TwoWay}">
          <TextBlock><Run Text="{x:Bind ViewModel.S.TierSafe}" /> <Run Text="{x:Bind ViewModel.SafeCount, Mode=OneWay}" Foreground="{ThemeResource NiskalaFaintBrush}" /></TextBlock>
        </ToggleButton>
        <ToggleButton Style="{StaticResource ChipStyle}" IsChecked="{x:Bind ViewModel.ShowReview, Mode=TwoWay}">
          <TextBlock><Run Text="{x:Bind ViewModel.S.TierReview}" /> <Run Text="{x:Bind ViewModel.ReviewCount, Mode=OneWay}" Foreground="{ThemeResource NiskalaFaintBrush}" /></TextBlock>
        </ToggleButton>
        <ToggleButton Style="{StaticResource ChipStyle}" IsChecked="{x:Bind ViewModel.ShowLow, Mode=TwoWay}">
          <TextBlock><Run Text="{x:Bind ViewModel.S.TierLow}" /> <Run Text="{x:Bind ViewModel.LowCount, Mode=OneWay}" Foreground="{ThemeResource NiskalaFaintBrush}" /></TextBlock>
        </ToggleButton>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <HyperlinkButton Content="{x:Bind ViewModel.S.CheckVisible}" Command="{x:Bind ViewModel.CheckVisibleCommand}" />
        <HyperlinkButton Content="{x:Bind ViewModel.S.ClearVisible}" Command="{x:Bind ViewModel.ClearVisibleCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="4">
      <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.Visible, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
              <Setter Property="MinHeight" Value="36" />
              <Setter Property="Padding" Value="8,0" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:LeftoverTreeRow">
              <Grid ColumnSpacing="6" Padding="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="{x:Bind Indent}" />
                <Button Grid.Column="1" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Command="{x:Bind ToggleCommand}"
                        Visibility="{x:Bind services:Format.Visible(CanExpand)}">
                  <FontIcon Glyph="{x:Bind Chevron, Mode=OneWay}" FontSize="10" />
                </Button>
                <CheckBox Grid.Column="2" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsThreeState="False" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                <FontIcon Grid.Column="3" Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource NiskalaMutedBrush}" />
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FullPath}" />
                  <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis"
                             Visibility="{x:Bind services:Format.VisibleText(Detail)}" />
                  <TextBlock Text="{x:Bind Note, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" Foreground="{ThemeResource NiskalaWarningBrush}"
                             Visibility="{x:Bind services:Format.VisibleText(Note), Mode=OneWay}" />
                </StackPanel>
                <Border Grid.Column="5" Style="{StaticResource PillStyle}" Visibility="{x:Bind services:Format.Visible(IsRoot)}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource NiskalaSuccessBrush}" Visibility="{x:Bind services:Format.Visible(IsSafe)}" VerticalAlignment="Center" />
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource NiskalaWarningBrush}" Visibility="{x:Bind services:Format.Visible(IsReview)}" VerticalAlignment="Center" />
                    <Ellipse Width="7" Height="7" Fill="{ThemeResource NiskalaFaintBrush}" Visibility="{x:Bind services:Format.Visible(IsLow)}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ScoreText}" Style="{StaticResource CaptionTextBlockStyle}" />
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Text="{x:Bind ViewModel.S.NothingFound}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind services:Format.Empty(ViewModel.Visible.Count), Mode=OneWay}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
      <Grid>
        <ScrollViewer Visibility="{x:Bind services:Format.Visible(ViewModel.HasSelection), Mode=OneWay}">
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{x:Bind ViewModel.Selected.LocationLabel, Mode=OneWay}" Style="{StaticResource SectionLabelStyle}" />
              <TextBlock Text="{x:Bind ViewModel.Selected.Location, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4" Visibility="{x:Bind services:Format.Visible(ViewModel.Selected.HasValueName), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.S.ValueName}" Style="{StaticResource SectionLabelStyle}" />
              <TextBlock Text="{x:Bind ViewModel.Selected.ValueNameText, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Style="{StaticResource PillStyle}">
                <TextBlock Text="{x:Bind ViewModel.Selected.KindText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
              </Border>
              <Border Style="{StaticResource PillStyle}">
                <TextBlock Text="{x:Bind ViewModel.Selected.TierText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
              </Border>
            </StackPanel>
            <StackPanel Spacing="4" Visibility="{x:Bind services:Format.Visible(ViewModel.Selected.HasData), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.S.ValueData}" Style="{StaticResource SectionLabelStyle}" />
              <TextBlock Text="{x:Bind ViewModel.Selected.Data, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Selected.SizeText, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}"
                       Visibility="{x:Bind services:Format.VisibleText(ViewModel.Selected.SizeText), Mode=OneWay}" />
            <TextBlock Style="{StaticResource CaptionMutedStyle}" Visibility="{x:Bind services:Format.VisibleText(ViewModel.Selected.Modified), Mode=OneWay}">
              <Run Text="{x:Bind ViewModel.S.Modified}" /> <Run Text="{x:Bind ViewModel.Selected.Modified, Mode=OneWay}" />
            </TextBlock>
            <StackPanel Spacing="4">
              <Grid>
                <TextBlock Text="{x:Bind ViewModel.S.Score}" Style="{StaticResource SectionLabelStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Selected.ScoreText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
              </Grid>
              <ProgressBar Maximum="1" Value="{x:Bind ViewModel.Selected.ScoreFraction, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.S.Reasons}" Style="{StaticResource SectionLabelStyle}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Selected.Reasons, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReasonRow">
                  <Grid ColumnSpacing="8" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PillStyle}" Background="{ThemeResource NiskalaAccentSoftBrush}" BorderThickness="0" VerticalAlignment="Top" HorizontalAlignment="Left">
                      <TextBlock Text="{x:Bind Weight}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource NiskalaAccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                      <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <TextBlock Text="{x:Bind ViewModel.S.SelectLeftover}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                   Visibility="{x:Bind services:Format.Collapsed(ViewModel.HasSelection), Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
