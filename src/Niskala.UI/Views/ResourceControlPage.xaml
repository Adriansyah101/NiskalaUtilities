<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Niskala.UI.Views.ResourceControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Niskala.UI.ViewModels"
    xmlns:services="using:Niskala.UI.Services">
  <Grid Padding="28,4,28,20" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.S.NavResources}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Bind ViewModel.S.ResourcesSubtitle}" Style="{StaticResource CaptionMutedStyle}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Top" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="{x:Bind ViewModel.S.Refresh}">
        <FontIcon Glyph="&#xE72C;" FontSize="14" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8">
      <InfoBar Severity="Error" IsClosable="True" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Error), Mode=OneWay}" />
      <InfoBar Severity="Informational" IsClosable="True" Message="{x:Bind ViewModel.Info, Mode=OneWay}" IsOpen="{x:Bind services:Format.HasText(ViewModel.Info), Mode=OneWay}" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
        <SelectorBarItem Text="{x:Bind ViewModel.S.TabStartup}" IsSelected="True" />
        <SelectorBarItem Text="{x:Bind ViewModel.S.TabServices}" />
        <SelectorBarItem Text="{x:Bind ViewModel.S.TabTasks}" />
        <SelectorBarItem Text="{x:Bind ViewModel.S.TabContextMenu}" />
      </SelectorBar>
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4">
      <Grid>
        <ListView x:Name="List" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:ResourceRow">
              <Grid ColumnSpacing="14" Padding="6,10" ToolTipService.ToolTip="{x:Bind LockReason}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource NiskalaPlateBrush}" VerticalAlignment="Top">
                  <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource NiskalaMutedBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{x:Bind Command}" Style="{StaticResource MonoTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Command}" />
                  <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionMutedStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource PillStyle}">
                  <TextBlock Text="{x:Bind Impact}" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
                <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                <Button Grid.Column="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
                  <FontIcon Glyph="&#xE712;" FontSize="14" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuFlyoutItem Text="{x:Bind services:Strings.Current.OpenLocation}" Click="OnOpenLocation" Tag="{x:Bind}" />
                      <MenuFlyoutItem Text="{x:Bind services:Strings.Current.Remove}" Click="OnRemove" Tag="{x:Bind}" IsEnabled="{x:Bind CanRemove}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.S.NothingHere}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{x:Bind services:Format.Empty(ViewModel.Rows.Count), Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
