<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Niskala.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Niskala.UI.Views"
    Title="Niskala Utilities">
  <Grid x:Name="Root" Background="{ThemeResource NiskalaBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Padding="16,0,0,0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="CaptionColumn" Width="138" />
      </Grid.ColumnDefinitions>
      <Border Width="24" Height="24" CornerRadius="6" Padding="5,5,3,5" Background="{StaticResource NiskalaBrandBrush}" VerticalAlignment="Center">
        <views:NiskalaMark />
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock x:Name="AppName" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" />
        <Border x:Name="AdminPill" Style="{StaticResource PillStyle}">
          <TextBlock x:Name="AdminText" Style="{StaticResource CaptionMutedStyle}" />
        </Border>
      </StackPanel>
      <Button x:Name="Launcher" Grid.Column="3" Width="460" MinWidth="0" Height="32" Padding="12,0" HorizontalContentAlignment="Stretch"
              Background="{ThemeResource NiskalaSurfaceBrush}" BorderBrush="{ThemeResource NiskalaStrokeBrush}" CornerRadius="8" Click="OnLauncherClick">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource NiskalaMutedBrush}" />
          <TextBlock x:Name="LauncherText" Grid.Column="1" Style="{StaticResource CaptionMutedStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="2" Style="{StaticResource PillStyle}" Padding="6,0,6,1">
            <TextBlock Text="Ctrl K" FontSize="11" Foreground="{ThemeResource NiskalaFaintBrush}" />
          </Border>
        </Grid>
      </Button>
    </Grid>

    <Border x:Name="Host" Grid.Row="1" />

    <Rectangle x:Name="DialogScrim" Grid.RowSpan="2" Fill="{ThemeResource NiskalaScrimBrush}" Visibility="Collapsed" />
  </Grid>
</Window>
