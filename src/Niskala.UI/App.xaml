<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Niskala.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#7C9CF0</Color>
          <Color x:Key="SystemAccentColorLight1">#8FAAF2</Color>
          <Color x:Key="SystemAccentColorLight2">#9DB5F4</Color>
          <Color x:Key="SystemAccentColorLight3">#B4C6F7</Color>
          <Color x:Key="SystemAccentColorDark1">#6787DB</Color>
          <Color x:Key="SystemAccentColorDark2">#526FC0</Color>
          <Color x:Key="SystemAccentColorDark3">#3F589E</Color>

          <SolidColorBrush x:Key="NiskalaBackgroundBrush" Color="#09090B" />
          <SolidColorBrush x:Key="NiskalaSurfaceBrush" Color="#121317" />
          <SolidColorBrush x:Key="NiskalaSurfaceRaisedBrush" Color="#191B21" />
          <SolidColorBrush x:Key="NiskalaHoverBrush" Color="#1E2027" />
          <SolidColorBrush x:Key="NiskalaStrokeBrush" Color="#25272F" />
          <SolidColorBrush x:Key="NiskalaMutedBrush" Color="#9A9DAA" />
          <SolidColorBrush x:Key="NiskalaFaintBrush" Color="#6C6F7C" />
          <SolidColorBrush x:Key="NiskalaAccentBrush" Color="#8FAAF2" />
          <SolidColorBrush x:Key="NiskalaAccentSoftBrush" Color="#1D2436" />
          <SolidColorBrush x:Key="NiskalaSuccessBrush" Color="#5CC79A" />
          <SolidColorBrush x:Key="NiskalaWarningBrush" Color="#E3B25E" />
          <SolidColorBrush x:Key="NiskalaDangerBrush" Color="#EA7A7E" />
          <SolidColorBrush x:Key="NiskalaPlateBrush" Color="#1F2128" />
          <SolidColorBrush x:Key="NiskalaPaneBrush" Color="#0E0F12" />
          <SolidColorBrush x:Key="NiskalaNavHoverBrush" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="NiskalaNavPressedBrush" Color="#0CFFFFFF" />
          <SolidColorBrush x:Key="NiskalaNavOpenBrush" Color="#10FFFFFF" />
          <SolidColorBrush x:Key="NiskalaNavGuideBrush" Color="#343846" />
          <SolidColorBrush x:Key="NiskalaScrimBrush" Color="#A6000000" />
          <SolidColorBrush x:Key="NiskalaMapFreeBrush" Color="#23262E" />
          <SolidColorBrush x:Key="NiskalaMapUsedBrush" Color="#5B86E5" />
          <SolidColorBrush x:Key="NiskalaMapFragmentedBrush" Color="#EF6A63" />
          <SolidColorBrush x:Key="NiskalaMapArchiveBrush" Color="#A889EC" />
          <SolidColorBrush x:Key="NiskalaMapSystemBrush" Color="#7C8190" />
          <SolidColorBrush x:Key="ContentDialogBackground" Color="#121317" />
          <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#191B21" />
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#25272F" />

          <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#09090B" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#16171C" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#121317" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#1E2027" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#1D2436" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#243049" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#2A3858" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#B4C6F7" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#C6D4FA" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#C6D4FA" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#25272F" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#3F589E" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#526FC0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#3E63D4</Color>
          <Color x:Key="SystemAccentColorLight1">#5677DB</Color>
          <Color x:Key="SystemAccentColorLight2">#728EE2</Color>
          <Color x:Key="SystemAccentColorLight3">#93A9EA</Color>
          <Color x:Key="SystemAccentColorDark1">#3557BE</Color>
          <Color x:Key="SystemAccentColorDark2">#2C4AA3</Color>
          <Color x:Key="SystemAccentColorDark3">#233B85</Color>

          <SolidColorBrush x:Key="NiskalaBackgroundBrush" Color="#F5F6F8" />
          <SolidColorBrush x:Key="NiskalaSurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="NiskalaSurfaceRaisedBrush" Color="#FBFBFC" />
          <SolidColorBrush x:Key="NiskalaHoverBrush" Color="#F0F1F4" />
          <SolidColorBrush x:Key="NiskalaStrokeBrush" Color="#E2E4EA" />
          <SolidColorBrush x:Key="NiskalaMutedBrush" Color="#5C6070" />
          <SolidColorBrush x:Key="NiskalaFaintBrush" Color="#8A8E9C" />
          <SolidColorBrush x:Key="NiskalaAccentBrush" Color="#3557BE" />
          <SolidColorBrush x:Key="NiskalaAccentSoftBrush" Color="#E9EEFC" />
          <SolidColorBrush x:Key="NiskalaSuccessBrush" Color="#1F8F5F" />
          <SolidColorBrush x:Key="NiskalaWarningBrush" Color="#A86A0C" />
          <SolidColorBrush x:Key="NiskalaDangerBrush" Color="#C23B40" />
          <SolidColorBrush x:Key="NiskalaPlateBrush" Color="#EEF0F4" />
          <SolidColorBrush x:Key="NiskalaPaneBrush" Color="#EEF0F3" />
          <SolidColorBrush x:Key="NiskalaNavHoverBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="NiskalaNavPressedBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="NiskalaNavOpenBrush" Color="#0B000000" />
          <SolidColorBrush x:Key="NiskalaNavGuideBrush" Color="#C9CDD8" />
          <SolidColorBrush x:Key="NiskalaScrimBrush" Color="#590B192C" />
          <SolidColorBrush x:Key="NiskalaMapFreeBrush" Color="#DFE2E9" />
          <SolidColorBrush x:Key="NiskalaMapUsedBrush" Color="#3E63D4" />
          <SolidColorBrush x:Key="NiskalaMapFragmentedBrush" Color="#CF3439" />
          <SolidColorBrush x:Key="NiskalaMapArchiveBrush" Color="#7650C8" />
          <SolidColorBrush x:Key="NiskalaMapSystemBrush" Color="#6F7484" />
          <SolidColorBrush x:Key="ContentDialogBackground" Color="#F5F6F8" />
          <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#E2E4EA" />

          <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F5F6F8" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#F0F1F4" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#E9EEFC" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#DCE4FA" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#CFD9F7" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#2C4AA3" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#233B85" />
          <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#233B85" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#E2E4EA" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#93A9EA" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#728EE2" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="NiskalaMonoFont">Cascadia Mono, Consolas</FontFamily>

      <LinearGradientBrush x:Key="NiskalaBrandBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#183D66" Offset="0" />
        <GradientStop Color="#08111E" Offset="1" />
      </LinearGradientBrush>

      <Style x:Key="ChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,4,12,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="13" />
      </Style>

      <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NiskalaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NiskalaStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
      </Style>

      <Style x:Key="PillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NiskalaSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NiskalaStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,1,8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>

      <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource NiskalaMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <Style x:Key="CaptionMutedStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource NiskalaMutedBrush}" />
      </Style>

      <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource NiskalaFaintBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
      </Style>

      <Style x:Key="MonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource NiskalaMonoFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
